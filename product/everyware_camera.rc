# The panel's camera (camera-app, README.md "How it starts"): started when the panel runs. It
# waits until the panel's Wayland socket answers, and ends when the panel goes away (its socket is
# gone or new): init starts it again, and it connects to the new panel. Root, because the panel's
# Wayland socket in its runtime directory (0750 root:oem_2900) is root's alone; the group camera
# opens /dev/video*. SELinux domain everyware_camera (the board's sepolicy/vendor).
# --clip: without a camera the app shows the image's clip (README.md "The clip").
# --still-interval 1: the tile's picture every second (the app's own default is 2).
service everyware_camera /vendor/bin/camera_app --data-path /vendor/etc/camera-app --clip /vendor/etc/camera-app/clip.mjpeg --still-interval 1
    class main
    user root
    group camera
    disabled
    setenv XDG_RUNTIME_DIR /data/vendor/everyware/run

on property:init.svc.smarthome=running
    start everyware_camera
